{
  "name": "@mindpeeker/vdf",
  "version": "0.2.0",
  "description": "Verifiable delay functions over an RSA group of unknown order — sequential-squaring time-locks in the signed quadratic residues, Pietrzak O(log T) and Wesolowski constant-size proofs, and beacon freshness seals.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/mindpeeker-sdk.git",
    "directory": "packages/vdf"
  },
  "homepage": "https://github.com/Polobase/mindpeeker-sdk/tree/main/packages/vdf#readme",
  "bugs": {
    "url": "https://github.com/Polobase/mindpeeker-sdk/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vdf",
    "verifiable-delay-function",
    "pietrzak",
    "wesolowski",
    "time-lock",
    "sequential-squaring",
    "rsa-2048",
    "randomness-beacon",
    "fiat-shamir",
    "proof-of-elapsed-time",
    "signed-quadratic-residues"
  ]
}
