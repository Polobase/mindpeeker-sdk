{
  "name": "@mindpeeker/negentropy",
  "version": "0.1.0",
  "description": "Measure order in noise and manufacture order from noise — GCP-style network statistics, negentropy estimators, and SP 800-90B extraction over any byte stream.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/mindpeeker-sdk.git",
    "directory": "packages/negentropy"
  },
  "homepage": "https://github.com/Polobase/mindpeeker-sdk/tree/main/packages/negentropy#readme",
  "bugs": {
    "url": "https://github.com/Polobase/mindpeeker-sdk/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./numerics": {
      "types": "./dist/numerics.d.ts",
      "default": "./dist/numerics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "negentropy",
    "entropy",
    "randomness",
    "statistics",
    "gcp",
    "rng",
    "randomness-extractor",
    "toeplitz",
    "min-entropy",
    "sp800-90b",
    "stouffer",
    "anomaly-detection"
  ]
}
