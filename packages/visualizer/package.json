{
  "name": "@mindpeeker/visualizer",
  "version": "0.1.0",
  "description": "Real-time dashboard for entropy/negentropy/PSI data — a Bun-native WebSocket server plus a zero-dependency WebGL2 client, with anytime-valid envelopes and hash-chained trial recording/replay.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/mindpeeker-sdk.git",
    "directory": "packages/visualizer"
  },
  "homepage": "https://github.com/Polobase/mindpeeker-sdk/tree/main/packages/visualizer#readme",
  "bugs": {
    "url": "https://github.com/Polobase/mindpeeker-sdk/issues"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "mindpeeker-viz": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/build-client.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit && tsc -p client/tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@mindpeeker/entropy": "workspace:*",
    "@mindpeeker/negentropy": "workspace:*",
    "@mindpeeker/psi": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "visualization",
    "dashboard",
    "webgl2",
    "websocket",
    "entropy",
    "negentropy",
    "rng",
    "gcp",
    "real-time",
    "bun"
  ]
}
