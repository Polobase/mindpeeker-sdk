{
  "name": "@mindpeeker/field",
  "version": "0.2.0",
  "description": "Spatial negentropy — turn an entropy stream into a point field and test it for order against a complete-spatial-randomness null: attractors and voids with calibrated whole-field Monte-Carlo p-values, edge-corrected Ripley's K with global envelope tests, Clark–Evans, quadrat counts, KDE attractors and Kulldorff's scan statistic. The sampling and null-model core of a Randonautica-style engine, plus exact spherical samplers and geohash.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/mindpeeker-sdk.git",
    "directory": "packages/field"
  },
  "homepage": "https://github.com/Polobase/mindpeeker-sdk/tree/main/packages/field#readme",
  "bugs": {
    "url": "https://github.com/Polobase/mindpeeker-sdk/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mindpeeker/negentropy": "workspace:*",
    "@mindpeeker/oracle": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "spatial",
    "point-pattern",
    "ripley-k",
    "clark-evans",
    "global-envelope",
    "scan-statistic",
    "kernel-density",
    "geohash",
    "complete-spatial-randomness",
    "attractor",
    "void",
    "randonautica",
    "quantum-random",
    "unbiased-sampling",
    "haversine",
    "mind-matter-interaction"
  ]
}
