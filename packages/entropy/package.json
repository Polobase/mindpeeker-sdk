{
  "name": "@mindpeeker/entropy",
  "version": "0.1.0",
  "description": "Provider-pluggable quantum (QRNG) and true (TRNG) randomness for web and Node — ANU, RANDOM.ORG, drand, NIST beacon and more, with composable fallback/xor/race strategies and streaming.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/mindpeeker-sdk.git",
    "directory": "packages/entropy"
  },
  "homepage": "https://github.com/Polobase/mindpeeker-sdk/tree/main/packages/entropy#readme",
  "bugs": {
    "url": "https://github.com/Polobase/mindpeeker-sdk/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "node": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.node.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.build.node.json --noEmit",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "bench:stream": "bun scripts/stream-bench.ts",
    "quality": "bun scripts/quality.ts",
    "demo:negentropy": "bun scripts/negentropy-demo.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "qrng",
    "trng",
    "entropy",
    "random",
    "quantum",
    "randomness",
    "drand",
    "csprng",
    "anu",
    "random.org"
  ]
}
