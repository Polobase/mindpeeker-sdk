{
  "name": "@mindpeeker/gematria",
  "version": "0.2.0",
  "description": "Pure, deterministic, multi-tradition gematria & isopsephy — 43 exact-integer ciphers across Hebrew, Greek, Arabic, Latin/English, Cyrillic, Armenian, Georgian, Coptic, Syriac and Gothic, temurah and tziruph tables, a public-domain lexicon, honest collision statistics, and an optional entropy-bridge oracle draw.",
  "type": "module",
  "sideEffects": [
    "./dist/lexicon.js",
    "./src/lexicon.ts"
  ],
  "license": "MIT",
  "author": "Manuel Haller Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polobase/mindpeeker-sdk.git",
    "directory": "packages/gematria"
  },
  "homepage": "https://github.com/Polobase/mindpeeker-sdk/tree/main/packages/gematria#readme",
  "bugs": {
    "url": "https://github.com/Polobase/mindpeeker-sdk/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oracle": {
      "types": "./dist/oracle.d.ts",
      "default": "./dist/oracle.js"
    },
    "./lexicon": {
      "types": "./dist/lexicon.d.ts",
      "default": "./dist/lexicon.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mindpeeker/oracle": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gematria",
    "isopsephy",
    "kabbalah",
    "hebrew",
    "greek",
    "atbash",
    "notariqon",
    "temurah",
    "agrippa",
    "milesian",
    "deterministic",
    "cipher"
  ]
}
