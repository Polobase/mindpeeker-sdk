{
  "name": "mindpeeker-sdk",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "workspaces": ["packages/*", "site"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "test": "bun test",
    "check": "biome check . && bun run typecheck && bun run check:readme",
    "check:readme": "bun scripts/check-readme-imports.ts",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  }
}
