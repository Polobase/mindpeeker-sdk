{
  "files": {
    "includes": [
      "packages/**",
      "site/**",
      "playground/**/*.ts",
      "scripts/**",
      "examples/**",
      "!**/dist",
      "!**/.claude-flow",
      "!**/.claude",
      "!playground/.nuxt",
      "!playground/.output",
      "!**/*.grit"
    ]
  },
  "plugins": ["./scripts/biome/unawaited-expect.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        "noFloatingPromises": "warn",
        "noMisusedPromises": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/test/**", "examples/test/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error",
            "noMisusedPromises": "error"
          }
        }
      }
    }
  ]
}
